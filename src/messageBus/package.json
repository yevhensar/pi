{
  "name": "pi-health-monitor",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "web",
    "agent"
  ],
  "scripts": {
    "build": "npm run build -w @pi-health/shared && npm run build -w @pi-health/agent && npm run build -w @pi-health/web && npm run build -w @pi-health/server",
    "start": "node scripts/run-with-message-token.mjs node server/dist/index.js",
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node scripts/run-with-message-token.mjs npm run dev -w @pi-health/server",
    "dev:web": "npm run dev -w @pi-health/web",
    "dev:agent": "node scripts/run-with-message-token.mjs npm run dev -w @pi-health/agent",
    "deploy:server": "bash scripts/deploy-server.sh",
    "deploy:client": "bash scripts/deploy-to-pi.sh",
    "deploy:clients": "bash scripts/deploy-fleet.sh --config config/pi-fleet.json",
    "token:init": "node scripts/message-token.mjs --init",
    "token:show": "node scripts/message-token.mjs --show",
    "token:regenerate": "node scripts/message-token.mjs --regenerate",
    "test:crypto": "npm run build -w @pi-health/shared && node --test shared/test/message-crypto.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
